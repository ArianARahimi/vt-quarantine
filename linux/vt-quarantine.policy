<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>vt-quarantine</vendor>
  <vendor_url>https://github.com/ArianARahimi/vt-quarantine</vendor_url>
  <action id="io.github.arianarahimi.vt-quarantine.update">
    <description>Install a vt-quarantine update</description>
    <message>Authentication is required to install the vt-quarantine update.</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/vt-quarantine</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--install-update</annotate>
  </action>
</policyconfig>
