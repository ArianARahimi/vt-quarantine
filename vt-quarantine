            ("GetWindowTextW", ctypes.c_int, (w.HWND, w.LPWSTR, ctypes.c_int)),
            ("IsDlgButtonChecked", w.UINT, (w.HWND, ctypes.c_int)),
            ("InvalidateRect", w.BOOL, (w.HWND, ctypes.c_void_p, w.BOOL)),
            ("SetFocus", w.HWND, (w.HWND,)),
