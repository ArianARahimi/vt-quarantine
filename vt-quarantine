            ("SetWindowPos", w.BOOL, (w.HWND, w.HWND, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int, w.UINT)),
            ("SetTimer", ctypes.c_size_t, (w.HWND, ctypes.c_size_t, w.UINT, ctypes.c_void_p)),
