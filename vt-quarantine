        try:
            m = re.search(r'^XDG_DOWNLOAD_DIR="([^"]*)"', user_dirs.read_text(), re.M)
        except (OSError, UnicodeDecodeError):
            m = None
        if m:
            path = Path(m.group(1).replace("$HOME", str(HOME)))
            # Pointing it at $HOME itself means "no Downloads folder" (xdg-user-dirs).
